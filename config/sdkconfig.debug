# Debug overlay: store a crash dump (ELF, CRC) in the coredump partition and show it at boot.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="config/partitions-debug.csv"
CONFIG_PARTITION_TABLE_FILENAME="config/partitions-debug.csv"
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=n
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=24
CONFIG_ESP_SYSTEM_PANIC_REBOOT=y
